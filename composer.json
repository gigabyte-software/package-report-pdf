{
    "name": "gigabyte/laravel-report-pdf",
    "description": "Sectioned PDF report generation for Laravel with cover sheets, TOC extraction, and Ghostscript merging.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Gigabyte Software"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "spatie/browsershot": "^5.2",
        "spatie/laravel-pdf": "^2.6"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Gigabyte\\ReportPdf\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gigabyte\\ReportPdf\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gigabyte\\ReportPdf\\ReportPdfServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
